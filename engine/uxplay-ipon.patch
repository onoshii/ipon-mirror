diff --git a/renderers/video_renderer.c b/renderers/video_renderer.c
index b6c1f1c..d862196 100644
--- a/renderers/video_renderer.c
+++ b/renderers/video_renderer.c
@@ -1238,3 +1238,21 @@ bool gstreamer_decoder_check(const char *decoder) {
     gst_object_unref(factory);
     return true;
 }
+
+/* iPhoneMirror: rotate the picture at runtime (0 identity, 1 90r, 2 180, 3 90l) */
+void video_renderer_set_rotation(int method) {
+    int count = 0;
+    for (int i = 0; i < n_renderers; i++) {
+        if (!renderer_type[i] || !renderer_type[i]->pipeline) continue;
+        GstElement *sink = gst_bin_get_by_interface(GST_BIN(renderer_type[i]->pipeline), GST_TYPE_VIDEO_OVERLAY);
+        if (sink) {
+            if (g_object_class_find_property(G_OBJECT_GET_CLASS(sink), "rotate-method")) {
+                g_object_set(sink, "rotate-method", method, NULL);
+                count++;
+            }
+            gst_object_unref(sink);
+        }
+    }
+    logger_log(logger, LOGGER_INFO, "*** iPhoneMirror: rotate %d (%d video sinks)", method, count);
+}
